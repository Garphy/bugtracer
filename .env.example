# ==============================================================================
# BugTracer 2.0 环境变量配置示例
# 复制此文件为 .env 即可生效：cp .env.example .env
# ==============================================================================

# -----------------
# 1. 基础与服务配置
# -----------------
PROJECT_NAME=BugTracer
VERSION=2.0.1
HOST=0.0.0.0
PORT=5002

# -----------------
# 2. 安全与密钥
# -----------------
# 生产环境请务必修改为强随机字符串
SECRET_KEY=bugtracer-super-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# -----------------
# 3. 初始系统管理员
# -----------------
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=123456
INITIAL_ADMIN_FULLNAME=系统管理员

# -----------------
# 4. 数据库引擎配置 (二选一)
# -----------------
# [选项 A] SQLite (默认推荐，单文件免安装，开箱即用)
DATABASE_URL=sqlite+aiosqlite:///./data/bugtracer.db

# [选项 B] MySQL / MariaDB (生产团队扩展推荐)
# DATABASE_URL=mysql+aiomysql://root:yourpassword@localhost:3306/bugtracer?charset=utf8mb4

# -----------------
# 5. 文件与附件存储
# -----------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=20971520

# -----------------
# 6. MCP 智能体服务
# -----------------
MCP_ENABLED=true
MCP_SERVER_NAME=BugTracer
