# =======================================================
# BugTracer 2.0 配置示例
# =======================================================

# 服务端口与主机
HOST=0.0.0.0
PORT=5002

# 数据库配置
# 1. 默认 SQLite (单文件零配置，开箱即用):
DATABASE_URL=sqlite+aiosqlite:///./data/bugtracer.db

# 2. 如需切换至 MySQL / MariaDB (取消下方注释并修改连接信息):
# DATABASE_URL=mysql+aiomysql://root:123456@localhost:3306/bugtracer?charset=utf8mb4

# 安全密钥 (生产环境建议修改)
SECRET_KEY=bugtracer-super-secret-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 初始管理员信息
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=123456
INITIAL_ADMIN_FULLNAME=系统管理员

# 文件存储目录与限制
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=20971520

# MCP (Model Context Protocol) AI Agent 服务
MCP_ENABLED=True
MCP_SERVER_NAME=BugTracer
